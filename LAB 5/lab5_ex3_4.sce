// ====================================================================
// Lab 5 - Problem 3.4: Determine the Z-transform of signals
// (a) x(n) = n*(-1)^n*u(n)
// (b) x(n) = n^2*u(n)
// (c) x(n) = -n*(a^n)*u(-n-1) (chon a = 0.5 de mo phong)
// (d) x(n) = (-1)^n * cos(pi*n/3) * u(n)
// (e) x(n) = (-1)^n * u(n)
// (f) x(n) = {1, 0, -1, 0, 1, -1, ...} (n = 0, 1, 2, 3, 4, 5)
// ====================================================================

clear;
clc;
clf;

figure(1);

// --------------------------------------------------------------------
// (a) x(n) = n * (-1)^n * u(n)
// --------------------------------------------------------------------
n_a = 0:10;
x_a = n_a .* ((-1).^n_a);

subplot(3, 2, 1);
plot2d3('gnn', n_a, x_a);
plot(n_a, x_a, 'bo');
xtitle('(a) x(n) = n(-1)^n u(n)', 'n', 'Biên độ');
gca().data_bounds = [-1, min(x_a) - 1; 11, max(x_a) + 1];
xgrid();

// --------------------------------------------------------------------
// (b) x(n) = n^2 * u(n)
// --------------------------------------------------------------------
n_b = 0:8;
x_b = n_b.^2;

subplot(3, 2, 2);
plot2d3('gnn', n_b, x_b);
plot(n_b, x_b, 'ro');
xtitle('(b) x(n) = n^2 u(n)', 'n', 'Biên độ');
gca().data_bounds = [-1, -5; 9, max(x_b) + 5];
xgrid();

// --------------------------------------------------------------------
// (c) x(n) = -n*(0.5^n)*u(-n-1) (Tin hieu phan nhan qua, n < 0)
// --------------------------------------------------------------------
n_c = -8:-1;
a_val = 0.5;
x_c = -n_c .* (a_val.^n_c);

subplot(3, 2, 3);
plot2d3('gnn', n_c, x_c);
plot(n_c, x_c, 'mo');
xtitle('(c) x(n) = -n a^n u(-n-1) (với a = 0.5)', 'n', 'Biên độ');
gca().data_bounds = [-9, -5; 0, max(x_c) + 10];
xgrid();

// --------------------------------------------------------------------
// (d) x(n) = (-1)^n * cos(pi*n/3) * u(n)
// --------------------------------------------------------------------
n_d = 0:12;
x_d = ((-1).^n_d) .* cos(%pi * n_d / 3);

subplot(3, 2, 4);
plot2d3('gnn', n_d, x_d);
plot(n_d, x_d, 'go');
xtitle('(d) x(n) = (-1)^n cos(\pi n / 3) u(n)', 'n', 'Biên độ');
gca().data_bounds = [-1, -1.3; 13, 1.3];
xgrid();

// --------------------------------------------------------------------
// (e) x(n) = (-1)^n * u(n)
// --------------------------------------------------------------------
n_e = 0:10;
x_e = (-1).^n_e;

subplot(3, 2, 5);
plot2d3('gnn', n_e, x_e);
plot(n_e, x_e, 'ko');
xtitle('(e) x(n) = (-1)^n u(n)', 'n', 'Biên độ');
gca().data_bounds = [-1, -1.3; 11, 1.3];
xgrid();

// --------------------------------------------------------------------
// (f) x(n) = [1, 0, -1, 0, 1, -1] (tai n = 0, 1, 2, 3, 4, 5)
// --------------------------------------------------------------------
n_f = 0:5;
x_f = [1, 0, -1, 0, 1, -1];

subplot(3, 2, 6);
plot2d3('gnn', n_f, x_f);
plot(n_f, x_f, 'co');
xtitle('(f) Chuỗi vô hạn x(n)', 'n', 'Biên độ');
gca().data_bounds = [-1, -1.5; 6, 1.5];
xgrid();
