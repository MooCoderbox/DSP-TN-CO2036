// ====================================================================
// Lab 5 - Problem 3.14: Causal Signals x(n) from X(z)
// Tách thành 2 cửa sổ đồ họa riêng biệt để hiển thị trực quan, rõ nét
// ====================================================================

clear;
clc;
clf;

// ====================================================================
// CỬA SỔ 1: figure(1) - Câu (a) đến Câu (f) [Lưới 3 hàng x 2 cột]
// ====================================================================
figure(1);

// --------------------------------------------------------------------
// (a) x(n) = [2*(-1)^n - (-2)^n] * u(n)
// --------------------------------------------------------------------
n_a = 0:6;
x_a = 2*((-1).^n_a) - ((-2).^n_a);

subplot(3, 2, 1);
plot2d3('gnn', n_a, x_a);
plot(n_a, x_a, 'bo');
xtitle('(a) x(n) = [2(-1)^n - (-2)^n] u(n)', 'n', 'Biên độ');
gca().data_bounds = [-0.8, min(x_a) - 5; 6.8, max(x_a) + 5];
xgrid();

// --------------------------------------------------------------------
// (b) x(n) = (1/sqrt(2))^n * [cos(pi*n/4) + sin(pi*n/4)] * u(n)
// --------------------------------------------------------------------
n_b = 0:12;
r_b = 1 / sqrt(2);
x_b = (r_b.^n_b) .* (cos(%pi*n_b/4) + sin(%pi*n_b/4));

subplot(3, 2, 2);
plot2d3('gnn', n_b, x_b);
plot(n_b, x_b, 'ro');
xtitle('(b) x(n) dao động tắt dần', 'n', 'Biên độ');
gca().data_bounds = [-0.8, -0.6; 12.8, 1.4];
xgrid();

// --------------------------------------------------------------------
// (c) x(n) = u(n - 6) + u(n - 7)
// --------------------------------------------------------------------
n_c = 0:12;
x_c = double(n_c >= 6) + double(n_c >= 7);

subplot(3, 2, 3);
plot2d3('gnn', n_c, x_c);
plot(n_c, x_c, 'mo');
xtitle('(c) x(n) = u(n-6) + u(n-7)', 'n', 'Biên độ');
gca().data_bounds = [-0.8, -0.2; 12.8, 2.5];
xgrid();

// --------------------------------------------------------------------
// (d) x(n) = 2*delta(n) - cos(pi*n/2)*u(n)
// --------------------------------------------------------------------
n_d = 0:8;
delta_d = zeros(1, length(n_d));
delta_d(1) = 1;
x_d = 2*delta_d - cos(%pi*n_d/2);

subplot(3, 2, 4);
plot2d3('gnn', n_d, x_d);
plot(n_d, x_d, 'go');
xtitle('(d) x(n) = 2\delta(n) - cos(\pi n / 2)u(n)', 'n', 'Biên độ');
gca().data_bounds = [-0.8, -1.5; 8.8, 2.5];
xgrid();

// --------------------------------------------------------------------
// (e) x(n) có cặp cực ngoài đường tròn đơn vị (dao động phân kỳ)
// --------------------------------------------------------------------
n_e = 0:8;
x_e = 0.85*(0.5.^n_e) - 0.6*(sqrt(2).^n_e).*cos(%pi*n_e/4) + 2.3*(sqrt(2).^n_e).*sin(%pi*n_e/4);

subplot(3, 2, 5);
plot2d3('gnn', n_e, x_e);
plot(n_e, x_e, 'ko');
xtitle('(e) x(n) có cực ngoài vòng đơn vị', 'n', 'Biên độ');
gca().data_bounds = [-0.8, min(x_e) - 2; 8.8, max(x_e) + 2];
xgrid();

// --------------------------------------------------------------------
// (f) x(n) = [1 + (0.5)^n] * u(n)
// --------------------------------------------------------------------
n_f = 0:10;
x_f = 1 + (0.5.^n_f);

subplot(3, 2, 6);
plot2d3('gnn', n_f, x_f);
plot(n_f, x_f, 'co');
xtitle('(f) x(n) = [1 + 0.5^n] u(n)', 'n', 'Biên độ');
gca().data_bounds = [-0.8, 0.5; 10.8, 2.3];
xgrid();


// ====================================================================
// CỬA SỔ 2: figure(2) - Câu (g) đến Câu (j) [Lưới 2 hàng x 2 cột]
// ====================================================================
figure(2);

// --------------------------------------------------------------------
// (g) x(n) = [3/4 + (1/4)n](-2)^n u(n) + (1/4)\delta(n)
// --------------------------------------------------------------------
n_g = 0:6;
x_g = zeros(1, length(n_g));
x_g(1) = 1; // x(0) = 1
for k = 2:length(n_g)
    n_val = n_g(k);
    x_g(k) = (0.75 + 0.25 * n_val) * ((-2)^n_val);
end

subplot(2, 2, 1);
plot2d3('gnn', n_g, x_g);
plot(n_g, x_g, 'bo');
xtitle('(g) x(n) trường hợp cực bội tại p = -2', 'n', 'Biên độ');
gca().data_bounds = [-0.8, min(x_g) - 10; 6.8, max(x_g) + 10];
xgrid();

// --------------------------------------------------------------------
// (h) x(n) từ Pole-Zero Pattern (Fig. P3.14)
// --------------------------------------------------------------------
n_h = 0:12;
r_h = 1 / sqrt(2);
x_h = 0.75 * (0.5.^n_h) - 0.5 * (r_h.^n_h) .* cos(%pi * n_h / 4) + 0.875 * (r_h.^n_h) .* sin(%pi * n_h / 4);

subplot(2, 2, 2);
plot2d3('gnn', n_h, x_h);
plot(n_h, x_h, 'ro');
xtitle('(h) x(n) từ giản đồ cực - không Fig. P3.14', 'n', 'Biên độ');
gca().data_bounds = [-0.8, min(x_h) - 0.2; 12.8, max(x_h) + 0.2];
xgrid();

// --------------------------------------------------------------------
// (i) x(n) = 2(-0.5)^n u(n) - \delta(n)
// --------------------------------------------------------------------
n_i = 0:8;
x_i = zeros(1, length(n_i));
x_i(1) = 1; // x(0) = 1
for k = 2:length(n_i)
    n_val = n_i(k);
    x_i(k) = 2 * ((-0.5)^n_val);
end

subplot(2, 2, 3);
plot2d3('gnn', n_i, x_i);
plot(n_i, x_i, 'mo');
xtitle('(i) x(n) = 2(-0.5)^n u(n) - \delta(n)', 'n', 'Biên độ');
gca().data_bounds = [-0.8, -1.3; 8.8, 1.3];
xgrid();

// --------------------------------------------------------------------
// (j) x(n) với a = 0.5: x(0) = -2, x(n) = -1.5 * 2^n (n >= 1)
// --------------------------------------------------------------------
a = 0.5;
n_j = 0:6;
x_j = zeros(1, length(n_j));
x_j(1) = -1 / a; // x(0) = -2
for k = 2:length(n_j)
    n_val = n_j(k);
    x_j(k) = (a - 1/a) * (a^(-n_val));
end

subplot(2, 2, 4);
plot2d3('gnn', n_j, x_j);
plot(n_j, x_j, 'ko');
xtitle('(j) x(n) với a = 0.5 (x(0)=-2, x(n)=-1.5 \cdot 2^n)', 'n', 'Biên độ');
gca().data_bounds = [-0.8, min(x_j) - 10; 6.8, 2];
xgrid();
