// ====================================================================
// Lab 5 - Exercise 2: Convolution using Z-Transform and Verification
// ====================================================================

clear;
clc;
clf;

figure(1);

// --------------------------------------------------------------------
// Câu a: x1(n) = [1, 2, 3, 4, 5], x2(n) = [1, 1, 1]
// y1(n) = [1, 3, 6, 9, 12, 9, 5] (n = 0..6)
// --------------------------------------------------------------------
x1_a = [1, 2, 3, 4, 5];
x2_a = [1, 1, 1];
y1 = convol(x1_a, x2_a);
n1 = 0:(length(y1) - 1);

subplot(3, 1, 1);
plot2d3('gnn', n1, y1);
plot(n1, y1, 'bo');
xtitle('Câu a: y_1(n) = x_1(n) * x_2(n)', 'n', 'Biên độ');
gca().data_bounds = [-1, 0; length(y1), max(y1) + 2];
xgrid();

// --------------------------------------------------------------------
// Câu b: x1(n) = (1/5)^n * u(n), x2(n) = 2^n * u(n)
// y2(n) = [ (10/9)*2^n - (1/9)*(1/5)^n ] * u(n)
// --------------------------------------------------------------------
n2 = 0:8;
y2 = (10/9)*(2.^n2) - (1/9)*((1/5).^n2);

subplot(3, 1, 2);
plot2d3('gnn', n2, y2);
plot(n2, y2, 'ro');
xtitle('Câu b: y_2(n) = [(10/9)*2^n - (1/9)*(1/5)^n] u(n)', 'n', 'Biên độ');
gca().data_bounds = [-0.8, 0; max(n2) + 0.8, max(y2) * 1.15];
xgrid();

// --------------------------------------------------------------------
// Câu c: x1(n) = n * u(n), x2(n) = 2^n * u(n-1)
// y3(n) = [ 2*(2^n) - 2 - 2n ] * u(n)
// --------------------------------------------------------------------
n3 = 0:8;
y3 = 2*(2.^n3) - 2 - 2*n3;

subplot(3, 1, 3);
plot2d3('gnn', n3, y3);
plot(n3, y3, 'mo');
xtitle('Câu c: y_3(n) = [2*(2^n) - 2 - 2n] u(n)', 'n', 'Biên độ');
gca().data_bounds = [-0.8, -2; max(n3) + 0.8, max(y3) * 1.15];
xgrid();
